# ─── BigQuery (the billing project that runs jobs) ───────────────────────────
# A GCP project WITH a billing account. This is what pays Google for query
# compute; you resell that compute over x402.
GCP_PROJECT_ID=your-billing-project

# Service-account auth. On Cloud Run you do NOT need this — leave it unset and the
# attached runtime service account (with roles/bigquery.jobUser) is used via
# Application Default Credentials. Only set this for hosts without a GCP identity:
# inline JSON here, or point GOOGLE_APPLICATION_CREDENTIALS at a key file.
# GCP_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"...","private_key":"...","client_email":"..."}

# Comma-separated projects whose datasets may be queried. Keep this tight.
ALLOWED_PROJECTS=bigquery-public-data

# Optional guards
BQ_LOCATION=US
MAX_BYTES_PER_QUERY=109951162777600   # 100 TiB
MAX_INLINE_ROWS=10000
QUERY_TIMEOUT_MS=60000
# Headroom on the per-query byte cap so dry-run/actual rounding deltas don't
# spuriously fail jobs. 1.2 = allow 20% over the quote before hard-failing.
BYTE_CAP_BUFFER=1.2

# ─── Pricing ─────────────────────────────────────────────────────────────────
# Defaults: ~$6.25/TiB, 2x markup, $0.002 floor, 10 MB/table minimum.
# USD_PER_BYTE=0.0000000000056843418860808015
PRICE_MARKUP=2.0
PRICE_FLOOR_USD=0.002

# ─── x402 settlement ─────────────────────────────────────────────────────────
# Use "base-sepolia" (testnet, no real money) until you're ready for mainnet.
X402_NETWORK=base-sepolia

# Address that receives USDC for queries.
PAY_TO_ADDRESS=0xYourReceivingWalletAddress

# Facilitator that verifies + settles payments. The x402.org public facilitator
# works for base-sepolia; for Base mainnet use the Coinbase CDP facilitator.
FACILITATOR_URL=https://x402.org/facilitator
# FACILITATOR_API_KEY=   # set if your facilitator requires a bearer token

QUOTE_TTL_SECONDS=60

# ─── Provisioning demo safety ────────────────────────────────────────────────
TEST_MODE=true
MAX_GCP_COST_PER_PROVISION_USD=5
MAX_OUTSTANDING_GCP_EXPOSURE_USD=20
MAX_RENTAL_MINUTES=60
GCP_ZONE=us-central1-a
GCP_VM_MACHINE_TYPE=e2-micro
GCP_VM_IMAGE=projects/debian-cloud/global/images/family/debian-12
# Required to view /dashboard
DASHBOARD_TOKEN=replace-with-a-long-dashboard-secret
RESOURCE_CAPABILITY_SECRET=replace-with-a-long-resource-secret
BETA_ACCESS_PASSWORD=stored-in-secret-manager
BETA_SESSION_SECRET=replace-with-a-long-random-secret
BETA_SESSION_TTL_SECONDS=28800
# Optional hosted MoonPay on-ramp. Test keys use MoonPay's Ethereum Sepolia test
# assets; this does not fund Base Sepolia x402. Store signing and webhook keys as secrets.
# MOONPAY_PUBLIC_KEY=pk_test_...
# MOONPAY_SECRET_KEY=sk_test_...
# MOONPAY_WEBHOOK_KEY=replace-with-moonpay-webhook-key
# MOONPAY_FIAT_AMOUNT_USD=30
# MOONPAY_WEBHOOK_MAX_AGE_SECONDS=300
# Required for automatic expiry cleanup. PUBLIC_BASE_URL is the deployed Cloud Run URL.
CLOUD_TASKS_QUEUE=gcp-x402-cleanup
CLOUD_TASKS_LOCATION=us-central1
PUBLIC_BASE_URL=https://your-service-xxxxx-uc.a.run.app
CLEANUP_TOKEN=replace-with-a-long-cleanup-secret

# Hyperliquid paper-trading stack (Tokyo). The image is built from ../trading-runtime.
# This release intentionally supports public market data and simulated orders only.
TRADING_REGION=asia-northeast1
TRADING_SPANNER_INSTANCE=gcp-x402-trading
TRADING_SPANNER_DATABASE=hyperliquid-demo
TRADING_RUNTIME_SERVICE_ACCOUNT=gcp-x402-trading-runtime@your-billing-project.iam.gserviceaccount.com
TRADING_PUBSUB_PUSH_SERVICE_ACCOUNT=gcp-x402-pubsub-push@your-billing-project.iam.gserviceaccount.com
TRADING_IMAGE=asia-northeast1-docker.pkg.dev/your-billing-project/gcp-x402/hyperliquid-paper:latest
TRADING_DASHBOARD_URL=https://your-project.web.app
TRADING_LEASE_HOURS=1

# ─── Quote signing ───────────────────────────────────────────────────────────
# Any long random secret. Generate with: openssl rand -base64 48
QUOTE_SECRET=replace-with-a-long-random-secret
