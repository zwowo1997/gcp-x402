# Copy this file outside the repository, fill it in, then source it.
# Do not put secret values in this file.

export TARGET_PROJECT_ID="replace-with-new-gcp-project-id"
export TARGET_REGION="asia-northeast1"
export TARGET_FIRESTORE_LOCATION="us-central1"

export SERVICE_NAME="gcp-x402-v3-preview"
export ARTIFACT_REPOSITORY="gcp-x402"
# Syntactically valid Base Sepolia address included in the simulated mandate.
# V3 preview never submits a transfer to it.
export PAY_TO_ADDRESS="0xReplaceWithReceivingAddress"

# Create this file outside the repo with mode 600. It must contain only the
# private-beta password, with an optional trailing newline.
export BETA_PASSWORD_FILE="/absolute/path/to/beta-password.txt"

# V3 beta is deliberately simulation-only. Do not enable real settlement until the
# production gates in V3-MIGRATION.md are complete.
export V3_REAL_SETTLEMENT_ENABLED="false"
export V3_PREVIEW_ONLY="true"
export V3_SIMULATION_STORE="firestore"
# For rollback only: a known-ready Cloud Run revision, set outside Git.
# export ROLLBACK_REVISION="gcp-x402-v3-preview-00001-abc"
